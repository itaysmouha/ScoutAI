# Copy to .env and replace <account-id> (see "Run locally" in the root README)
AWS_PROFILE=scoutai-app
AWS_REGION=eu-central-1
S3_BUCKET=scoutai-itaysmouha-media
JOBS_TABLE=ScoutAI-Jobs
SQS_JOBS_URL=https://sqs.eu-central-1.amazonaws.com/<account-id>/ScoutAI-Jobs
PRESIGN_TTL=900
# Comma-separated browser origins allowed to call the API (Vite dev server by default)
CORS_ORIGINS=http://localhost:5173
